{
  "editor.inlayHints.enabled": "on",
  "editor.formatOnSave": true,
  "files.associations": {
    "*.hpp": "cpp",
    "*.h": "cpp",
    "*.cpp": "cpp",
    "format": "cpp",
    "vector": "cpp",
    "string_view": "cpp",
    "algorithm": "cpp",
    "iostream": "cpp"
  },
  "clangd.arguments": [
    "--background-index",
    "--clang-tidy",
    "--header-insertion=iwyu",
    "--completion-style=detailed"
  ],
  "clangd.fallbackFlags": [
    "-std=c++20",
    "-Wall",
    "-Wextra",
    "-I${workspaceFolder}/include"
  ],
  "clangd.checkUpdates": true,
  "makefile.configurations": [
    {
      "name": "Default",
      "makeArgs": []
    }
  ]
}
